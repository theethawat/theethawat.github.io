  width="24"
  height="24"
  fill="currentColor"
  viewBox="0 0 1000 840"
>
  <!-- White "D" -->
  <path
    fill="currentColor"
    fill-rule="evenodd"
    d="
    M 222 276
    H 322
    C 418 276, 467 329, 467 428
