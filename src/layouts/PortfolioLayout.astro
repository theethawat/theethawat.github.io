---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import Footer from "../components/Footer.astro";
import { messages, type Locale } from "../data/i18n";

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  alternateLocales?: Locale[];
}

const {
  locale,
  title,
  description = messages[locale].siteDescription,
  alternateLocales = ["en", "th"],
} = Astro.props;
const t = messages[locale];
const path = Astro.url.pathname.replace(/^\/(en|th)(?=\/|$)/, "") || "/";
const nav = [
  ["", t.home],
  ["about", t.about],
  ["timeline", t.timeline],
  ["project", t.projects],
  ["https://blog.theethawat.dev", t.blog],
  ["skill", t.skills],
  ["cv", t.cv],
  ["vcard", t.contact],
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | Theethawat Savastham</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.url.origin)}
    />
    {alternateLocales.map((language) => (
      <link
        rel="alternate"
        hreflang={language}
        href={new URL(`/${language}${path}`, Astro.url.origin)}
      />
    ))}
    <meta property="og:title" content={`${title} | Theethawat Savastham`} />
    <meta property="og:description" content={description} />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.url.origin)}
    />
    <style>
      .site-logo-dark {
        display: none;
      }

      :global(html[data-theme="dark"]) .site-logo-light {
        display: none;
      }

      :global(html[data-theme="dark"]) .site-logo-dark {
        display: block;
      }
    </style>
  </head>
  <body class="min-h-screen bg-base-100 text-base-content">
    <header class="border-b border-base-300">
      <div class="mx-auto max-w-6xl px-4 py-4 flex flex-wrap items-center justify-between gap-4">
        <a href={`/${locale}/`} aria-label="Theethawat Savastham home">
          <img src="/img/logo.png" alt="" class="site-logo-light h-14" />
          <img src="/img/logo-white.png" alt="" class="site-logo-dark h-14" />
        </a>
        <div class="flex items-center gap-3">
          <nav aria-label="Language" class="join">
            <a
              class:list={[
                "btn btn-sm join-item",
                { "btn-active": locale === "en" },
              ]}
              href={`/en${path}`}
              lang="en"
              aria-current={locale === "en" ? "true" : undefined}
            >
              EN
            </a>
            <a
              class:list={[
                "btn btn-sm join-item",
                { "btn-active": locale === "th" },
              ]}
              href={`/th${path}`}
              lang="th"
              aria-current={locale === "th" ? "true" : undefined}
            >
              ไทย
            </a>
          </nav>
          <ThemeToggle />
        </div>
        <nav
          aria-label={t.home}
          class="w-full flex flex-wrap gap-x-4 gap-y-2 text-sm"
        >
          {nav.map(([href, label]) => {
            const isExternal = href.startsWith("https://");
            return (
              <a
                class="link link-hover"
                href={isExternal ? href : `/${locale}/${href}`}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
              >
                {label}
              </a>
            );
          })}
        </nav>
      </div>
    </header>
    <slot />
    <Footer />
  </body>
</html>
