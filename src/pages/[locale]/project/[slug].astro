---
import { getEntry, render } from "astro:content";
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import { isLocale } from "../../../data/i18n";
import projects from "../../../data/portfolio.json";
import { resolveContentSidebar } from "../../../utils/contentSidebar";
import { getSiteContentPaths, locales } from "../../../utils/sitePaths";
import _ from "lodash";

export async function getStaticPaths() {
  const paths = await getSiteContentPaths();
  const slugs = paths
    .filter((path) => /^project\/[^/]+$/.test(path))
    .map((path) => path.slice("project/".length));
  return locales.flatMap((locale) =>
    slugs.map((slug) => ({ params: { locale, slug } })),
  );
}

const { locale, slug } = Astro.params;
if (!isLocale(locale) || !slug) return Astro.redirect("/404");

const requested = await getEntry("site", `${locale}/project/${slug}`);
const alternate = await getEntry(
  "site",
  `${locale === "en" ? "th" : "en"}/project/${slug}`,
);
const entry = requested ?? alternate;
if (!entry) return new Response("Not found", { status: 404 });

const { Content, headings } = await render(entry);
const project = projects.find((item) => item.link === slug);
const general = await getEntry("general", "index");
const alternateLocales = [
  ...new Set(
    [requested?.data.contentLanguage, alternate?.data.contentLanguage].filter(
      isLocale,
    ),
  ),
];
---

<ProjectLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.subtitle}
  contentLanguage={entry.data.contentLanguage}
  sourceLink={entry.data.sourceLink}
  alternateLocales={alternateLocales}
  image={project?.image}
  period={project?.year?.toString()}
  skills={project?.language}
  headings={headings}
  projectType={entry.data.projectType}
  adviser={entry.data.adviser}
  organization={entry.data.organization}
  demoLink={entry.data.demoLink}
  startDate={project?.startDate ? new Date(project?.startDate) : undefined}
  endDate={project?.endDate ? new Date(project?.endDate) : undefined}
  contentSidebar={resolveContentSidebar(general?.data, undefined)}
>
  <Content />
</ProjectLayout>
