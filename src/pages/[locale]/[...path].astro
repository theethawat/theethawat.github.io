---
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import PortfolioProjects from "../../components/PortfolioProjects.astro";
import { getCollection, getEntry, render } from "astro:content";
import { isLocale, messages } from "../../data/i18n";
import { getSiteContentPaths, locales } from "../../utils/sitePaths";

export async function getStaticPaths() {
  const contentPaths = await getSiteContentPaths();
  const paths = new Set([
    "project",
    "blog",
    ...contentPaths.filter((path) => !/^project\/[^/]+$/.test(path)),
  ]);
  return locales.flatMap((locale) =>
    [...paths].map((path) => ({ params: { locale, path } })),
  );
}

const { locale, path } = Astro.params;
if (!isLocale(locale) || !path) return Astro.redirect("/404");
const t = messages[locale];
const normalizedPath = path.replace(/\/$/, "");
const isProjects = normalizedPath === "project";
const isBlog = normalizedPath === "blog";
const requested =
  !isProjects && !isBlog
    ? await getEntry("site", `${locale}/${normalizedPath}`)
    : undefined;
const alternate =
  !isProjects && !isBlog
    ? await getEntry(
        "site",
        `${locale === "en" ? "th" : "en"}/${normalizedPath}`,
      )
    : undefined;
const entry = requested ?? alternate;
if (!isProjects && !isBlog && !entry) {
  return new Response("Not found", { status: 404 });
}
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const posts = isBlog
  ? (
      await getCollection("site", ({ id }) => id.startsWith("th/blog/post/"))
    ).sort(
      (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
    )
  : [];
const title = isProjects ? t.projects : isBlog ? t.blog : entry!.data.title;
const alternateLocales = entry
  ? [
      ...new Set(
        [
          requested?.data.contentLanguage,
          alternate?.data.contentLanguage,
        ].filter(isLocale),
      ),
    ]
  : undefined;
---

<PortfolioLayout
  locale={locale}
  title={title}
  alternateLocales={alternateLocales}
>
  <main class="mx-auto max-w-6xl px-4 py-12">
    <header class="mb-10">
      <h1 class="text-4xl font-bold">{title}</h1>
      {
        entry?.data.subtitle && (
          <p class="mt-3 text-lg text-base-content/70">{entry.data.subtitle}</p>
        )
      }
    </header>
    {
      isProjects && (
        <>
          <>
            <PortfolioProjects locale={locale} />
            <p class="mt-8">
              <a class="link link-primary" href={`/${locale}/project/summary`}>
                {t.projectHistory}
              </a>
            </p>
          </>
        </>
      )
    }
    {
      isBlog && (
        <div class="grid gap-4 md:grid-cols-2">
          {posts.length === 0 && <p>{t.emptyBlog}</p>}
          {posts.map((post) => (
            <article class="card bg-base-200">
              <div class="card-body">
                <h2 class="card-title" lang={post.data.contentLanguage}>
                  <a
                    class="link link-hover"
                    href={`/${locale}/${post.id.replace(/^th\//, "")}`}
                  >
                    {post.data.title}
                  </a>
                </h2>
                {post.data.date && (
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toISOString().slice(0, 10)}
                  </time>
                )}
                {locale !== post.data.contentLanguage && (
                  <p class="text-sm">{t.original}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      )
    }
    {
      entry && Content && (
        <>
          {normalizedPath === "cv" && (
            <div class="alert mb-6">
              <span>
                {t.archivedCv}{" "}
                <a class="link" href="/file/Resume-20230412.pdf">
                  {t.downloadCv}
                </a>
              </span>
            </div>
          )}
          {normalizedPath === "event" && (
            <p class="alert mb-6">{t.archivedEvents}</p>
          )}
          {entry.data.contentLanguage !== locale && (
            <p role="status" class="alert alert-info mb-6">
              {t.original}
            </p>
          )}
          <article class="prose max-w-none" lang={entry.data.contentLanguage}>
            <Content />
          </article>
        </>
      )
    }
  </main>
</PortfolioLayout>
